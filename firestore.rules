rules_version = '2';
// ==============================================================================
// SPENDLY — CLOUD FIRESTORE SECURITY RULES
// ==============================================================================
// DEPLOYMENT STATUS NOTICE:
// These rules are version-controlled locally within the Spendly repository.
// They are NOT active in Google Cloud Firestore until explicitly deployed.
//
// To deploy these rules to your live Firebase project, execute:
//   1. npm install -g firebase-tools (or npx -y firebase-tools)
//   2. firebase login
//   3. firebase use <your-project-id>
//   4. firebase deploy --only firestore:rules
//
// DATA SAFETY & PRIVACY GUARANTEE:
// - Arbitrary root-level access is denied (match /{document=**} -> if false).
// - Strict user isolation: All financial records are isolated under /users/{userId}.
// - Cross-user data access is strictly forbidden; a user can only read/write documents
//   if request.auth.uid exactly matches {userId}.
// ==============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Disallow arbitrary global access
    match /{document=**} {
      allow read, write: if false;
    }

    // User root document and private partitioned subcollections
    match /users/{userId} {
      // User can only read and update their own root document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Custom Categories subcollection
      match /custom_categories/{categoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Budget subcollection
      match /budget/{budgetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
